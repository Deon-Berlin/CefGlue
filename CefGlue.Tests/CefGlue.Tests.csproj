<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(DotnetVersion)</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug_WindowlessRender'">
    <DefineConstants>$(DefineConstants);DEBUG</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DefineConstants>$(DefineConstants);DEBUG</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Helpers\App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Helpers\App.xaml">
      <Generator>MSBuild:Compile</Generator>
    </AvaloniaResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="nunit" />
    <PackageReference Include="NUnit3TestAdapter" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Moq" />
    <PackageReference Include="Avalonia.Themes.Simple" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CefGlue.Avalonia\CefGlue.Avalonia.csproj" />
    <ProjectReference Include="..\CefGlue.BrowserProcess\CefGlue.BrowserProcess.csproj" />
    <ProjectReference Include="..\CefGlue.Common\CefGlue.Common.csproj" />
    <ProjectReference Include="..\CefGlue\CefGlue.csproj" />
  </ItemGroup>

  <Import Project="$(ProjectDir)..\CefGlue.Packages.props" />
  <Import Project="$(ProjectDir)..\CefGlue.Common\build\CefGlue.Common.targets" />

  <!--
    Deploy the CEF sub-process (Xilium.CefGlue.BrowserProcess) into an isolated
    'subprocess' subfolder of the test output.

    BrowserProcess carries its own .NET runtime. A plain ProjectReference only copies its
    managed assemblies into the test output root, so the exe there has no runtime beside it
    and blocks on an "install .NET" dialog when CEF spawns it as a render/GPU sub-process.
    The runtime cannot go in the output root either, because it clashes with the
    framework-dependent test host. So deploy the sub-process into its own subfolder.

    The deploy MIRRORS the source (wipes the destination first). This is essential: BrowserProcess's
    $(rid) build output can be framework-dependent or self-contained depending on build history,
    and a plain copy-if-newer leaves stale files behind — e.g. a coreclr.dll from a previous
    self-contained build sitting next to a later framework-dependent runtimeconfig. That
    inconsistent mix makes the apphost fail with the "install .NET" dialog. Mirroring guarantees
    the deployed folder exactly matches the current (internally consistent) build output.
  -->
  <PropertyGroup>
    <CefSubprocessRid Condition="'$(CefSubprocessRid)' == '' AND $([MSBuild]::IsOSPlatform('Windows'))">win-x64</CefSubprocessRid>
    <CefSubprocessRid Condition="'$(CefSubprocessRid)' == '' AND $([MSBuild]::IsOSPlatform('Linux'))">linux-x64</CefSubprocessRid>
    <CefSubprocessRid Condition="'$(CefSubprocessRid)' == '' AND $([MSBuild]::IsOSPlatform('OSX'))">osx-arm64</CefSubprocessRid>
    <CefSubprocessSourceDir>$(MSBuildThisFileDirectory)..\CefGlue.BrowserProcess\bin\$(Configuration)\$(TargetFramework)\$(CefSubprocessRid)\</CefSubprocessSourceDir>
  </PropertyGroup>

  <Target Name="DeployCefSubprocess" AfterTargets="Build"
          Condition="Exists('$(CefSubprocessSourceDir)')">
    <!-- $(OutDir) is only resolved during the build, so reference it directly in the target
         (not in a pre-evaluated property). Wipe stale files so the deployed folder exactly
         matches the current build output. -->
    <RemoveDir Directories="$(OutDir)subprocess\" />
    <ItemGroup>
      <!-- Everything from the sub-process output except its own nested publish/ folder. -->
      <_CefSubprocessFiles Include="$(CefSubprocessSourceDir)**\*.*"
                           Exclude="$(CefSubprocessSourceDir)publish\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_CefSubprocessFiles)"
          DestinationFiles="@(_CefSubprocessFiles->'$(OutDir)subprocess\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="false" />
  </Target>

</Project>
