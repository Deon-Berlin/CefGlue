<Window xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:avalonia="clr-namespace:Xilium.CefGlue.Demo.Avalonia"
    x:Class="Xilium.CefGlue.Demo.Avalonia.MainWindow"
    MinWidth="500"
    MinHeight="300"
    Title="Avalonia CefGlue Demo">
    <NativeMenu.Menu>
        <NativeMenu>
            <NativeMenuItem Header="File">
                <NativeMenuItem.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="New Tab" Click="OnNewTabNativeMenuItemClick" />
                        <NativeMenuItem Header="Open Dev Tools..."
                            Click="OnOpenDevToolsNativeMenuItemClick" />
                        <NativeMenuItem Header="Evaluate Javascript"
                            Click="OnEvaluateJavascriptNativeMenuItemClick" />
                        <NativeMenuItem Header="Bind Javascript Object"
                            Click="OnBindJavascriptObjectNativeMenuItemClick" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="Website Snapshot..."
                            Click="OnWebsiteSnapshotNativeMenuItemClick" />
                        <NativeMenuItem Header="Toggle Overlay"
                            Click="OnToggleOverlayNativeMenuItemClick"
                            IsEnabled="{Binding Source={x:Static avalonia:Program.IsOSR}}"/>
                    </NativeMenu>
                </NativeMenuItem.Menu>
            </NativeMenuItem>
        </NativeMenu>
    </NativeMenu.Menu>

    <DockPanel>
        <Menu Name="mainMenu" DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New Tab" Click="OnNewTabMenuItemClick" />
                <MenuItem Header="_Open Dev Tools..." Click="OnOpenDevToolsMenuItemClick" />
                <MenuItem Header="_Evaluate Javascript" Click="OnEvaluateJavascriptMenuItemClick" />
                <MenuItem Header="_Bind Javascript Object"
                    Click="OnBindJavascriptObjectMenuItemClick" />
                <Separator />
                <MenuItem Header="_Website Snapshot..." Click="OnWebsiteSnapshotMenuItemClick" />
                <MenuItem Header="_Toggle Overlay" Click="OnToggleOverlayMenuItemClick" 
                          IsEnabled="{Binding Source={x:Static avalonia:Program.IsOSR}}" />
            </MenuItem>
        </Menu>

        <Grid>
            <TabControl Name="tabControl" />
            <Ellipse Name="overlay" Width="100" Height="100" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="Red" Opacity="0.5" IsVisible="False" />
        </Grid>
        
    </DockPanel>
</Window>