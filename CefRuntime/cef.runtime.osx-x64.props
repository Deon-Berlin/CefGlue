<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <_CefDefaultCopyToBundleAfterTarget>_LinkNativeExecutable</_CefDefaultCopyToBundleAfterTarget>
    <_CefFrameworkBundleDepoyScript>$(MSBuildThisFileDirectory)../CEF/deploy-cef-framework.sh</_CefFrameworkBundleDepoyScript>
    <_CefDefaultEntitlements>$(MSBuildThisFileDirectory)../CEF/cef.entitlements</_CefDefaultEntitlements>
    <_CefDefaultAlertAppIcons>$(MSBuildThisFileDirectory)../CEF/app.icns</_CefDefaultAlertAppIcons>
  </PropertyGroup>

  <!-- Publish CEF Framework with helper apps to the app bundle created when bulding netX.0-macos target framework projects -->
  <Target Name="CefRedistOSX64CopyBundleResources"
          AfterTargets="_LinkNativeExecutable"
          Condition="$(TargetFramework.EndsWith('-macos')) AND '$(RuntimeIdentifier)' == 'osx-x64' AND '$(OutputType)' == 'Exe'">

    <PropertyGroup>
      <_CefClientFrameworks>$(MSBuildThisFileDirectory)../CEF/$(RuntimeIdentifier)</_CefClientFrameworks>
      <_CefDestFrameworks>$(_AppBundlePath)Contents/Frameworks</_CefDestFrameworks>

      <!-- set default values from net-macos bundling -->
      <CFBundleName Condition="'$(CFBundleName)' == ''">$(_AppBundleName)</CFBundleName>
      <CFBundleIdentifier Condition="'$(CFBundleIdentifier)' == ''">$(ApplicationId)</CFBundleIdentifier>
      <CefBundleCodesignKey Condition="'$(CefBundleCodesignKey)' == ''">$(CodesignKey)</CefBundleCodesignKey>
      <CefBundleCodesignKey Condition="'$(CefBundleCodesignKey)' == ''">-</CefBundleCodesignKey>
      <CefBundleEntitlementsFile Condition="'$(CefBundleEntitlementsFile)' == ''">$(_CefDefaultEntitlements)</CefBundleEntitlementsFile>
      <CefBundleAppIcons Condition="'$(CefBundleAppIcons)' == ''">$(_CefDefaultAlertAppIcons)</CefBundleAppIcons>
    </PropertyGroup>

    <Message Importance="high" Text="Adding CEF Framework to AppBundle $(_AppBundlePath) with RuntimeIdentifier $(RuntimeIdentifier)" />
    <Message Importance="high" Text="Code Signing using '$(CefBundleCodesignKey)' with entitlements '$(CefBundleEntitlementsFile)'" />

    <Exec Command="chmod 755 $(_CefFrameworkBundleDepoyScript)" />
    <Exec Command="bash &quot;$(_CefFrameworkBundleDepoyScript)&quot; \
          &quot;$(_CefClientFrameworks)&quot; \
          &quot;$(_CefDestFrameworks)&quot; \
          &quot;$(CFBundleName)&quot; \
          &quot;$(CFBundleIdentifier)&quot; \
          &quot;$(CefBundleCodesignKey)&quot; \
          &quot;$(CefBundleEntitlementsFile)&quot; \
          &quot;$(CefBundleAppIcons)&quot;" />

  </Target>

  <!-- Publish CEF libs and Resources for standard builds without App Bundle -->
  <Target Name="CefRedistOSX64CopyResources"
          AfterTargets="Build"
          Condition="!$(TargetFramework.EndsWith('-macos')) AND '$(RuntimeIdentifier)' == 'osx-x64' AND '$(OutputType)' == 'Exe'">

    <Message Importance="high" Text="Publishing CEF Framework to $(TargetDir) with RuntimeIdentifier $(RuntimeIdentifier)" />

    <PropertyGroup Condition="'$(_AppBundlePath)' == ''">
      <CefResistOSX64SourceDir>$(MSBuildThisFileDirectory)../CEF/osx-x64</CefResistOSX64SourceDir>
      <CefRedistOSX64TargetDir Condition="'$(CefRedistOSX64TargetDir)' == ''">$(TargetDir)</CefRedistOSX64TargetDir>
      <CefRedistOSX64ResourceTargetDir Condition="'$(CefRedistOSX64ResourceTargetDir)' == ''">$(TargetDir)\Resources</CefRedistOSX64ResourceTargetDir>
    </PropertyGroup>

    <ItemGroup>
      <_CefRuntimeOSX64Main Include="$(CefResistOSX64SourceDir)/Chromium Embedded Framework" />
      <_CefRuntimeOSX64Libraries Include="$(CefResistOSX64SourceDir)/Libraries/**/*.*" />
      <_CefRuntimeOSX64Resources Include="$(CefResistOSX64SourceDir)/Resources/**/*.*" />
    </ItemGroup>

    <Message Importance="high" Text="Copying Chromium Embedded Framework Runtime x64 files from $(CefResistOSX64SourceDir) to $(CefRedistOSX64TargetDir)" />
    <Copy SourceFiles="@(_CefRuntimeOSX64Main)" DestinationFiles="@(_CefRuntimeOSX64Main->'$(CefRedistOSX64TargetDir)\libcef.dylib')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_CefRuntimeOSX64Libraries)" DestinationFiles="@(_CefRuntimeOSX64Libraries->'$(CefRedistOSX64TargetDir)\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_CefRuntimeOSX64Resources)" DestinationFiles="@(_CefRuntimeOSX64Resources->'$(CefRedistOSX64ResourceTargetDir)\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="ResignBundleAfterCefCopy"
          Condition="'$(_AppBundlePath)' != '' AND $([MSBuild]::IsOSPlatform('OSX'))">
    <Message Importance="high" Text="Re-signing the application bundle with identity: $(CefBundleCodesignKey)" />

    <!-- Adhoc signing (-) does not support -options runtime; Developer ID requires it for SecCodeCopySelf on macOS 15 -->
    <Exec Condition="'$(CefBundleCodesignKey)' == '-' OR '$(CodesignEntitlements)' == ''"
          Command="codesign --force --timestamp --sign &quot;$(CefBundleCodesignKey)&quot; &quot;$(_AppBundlePath)&quot;" />
    <Exec Condition="'$(CefBundleCodesignKey)' != '-' AND '$(CodesignEntitlements)' != ''"
          Command="codesign --force --timestamp --options runtime --entitlements &quot;$(CodesignEntitlements)&quot; --sign &quot;$(CefBundleCodesignKey)&quot; &quot;$(_AppBundlePath)&quot;" />
  </Target>
</Project>