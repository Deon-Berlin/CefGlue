<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <_CefDefaultCopyToBundleAfterTarget>_LinkNativeExecutable</_CefDefaultCopyToBundleAfterTarget>
    <_CefFrameworkBundleDepoyScript>$(MSBuildThisFileDirectory)../CEF/deploy-cef-framework.sh</_CefFrameworkBundleDepoyScript>
  </PropertyGroup>

  <!-- Publish CEF Framework with helper apps to the app bundle created when bulding netX.0-macos target framework projects -->
  <Target Name="CefRedistOSXArm64CopyBundleResources" 
          AfterTargets="_LinkNativeExecutable" 
          Condition="$(TargetFramework.EndsWith('-macos')) AND '$(RuntimeIdentifier)' == 'osx-arm64' AND '$(OutputType)' == 'Exe'">
    
    <PropertyGroup>
      <_CefClientFrameworks>$(MSBuildThisFileDirectory)../CEF/$(RuntimeIdentifier)</_CefClientFrameworks>
      <_CefDestFrameworks>$(_AppBundlePath)Contents/Frameworks</_CefDestFrameworks>
      
      <CefBundleCodesignKey Condition="'$(CefBundleCodesignKey)' == ''">$(CodesignKey)</CefBundleCodesignKey>
    </PropertyGroup>
        
    <Message Importance="high" Text="Adding CEF Framework to AppBundle $(_AppBundlePath) with RuntimeIdentifier $(RuntimeIdentifier)" />
    <Message Importance="high" Text="Code Signing using '$(CefBundleCodesignKey)' with entitlements '$(CefBundleEntitlementsFile)'" />
    
    <Exec Command="chmod 755 $(_CefFrameworkBundleDepoyScript)" />
    <Exec Command="bash &quot;$(_CefFrameworkBundleDepoyScript)&quot; \
          &quot;$(_CefClientFrameworks)&quot; \
          &quot;$(_CefDestFrameworks)&quot; \
          &quot;$(CFBundleName)&quot; \
          &quot;$(CFBundleIdentifier)&quot; \
          &quot;$(CefBundleCodesignKey)&quot; \
          &quot;$(CefBundleEntitlementsFile)&quot;" />

  </Target>
  
  <!-- Publish CEF libs and Resources for standard builds without App Bundle -->
  <Target Name="CefRedistOSXArm64CopyResources" 
          AfterTargets="Build" 
          Condition="!$(TargetFramework.EndsWith('-macos')) AND '$(RuntimeIdentifier)' == 'osx-arm64' AND '$(OutputType)' == 'Exe'">
    
    <Message Importance="high" Text="Publishing CEF Framework to $(TargetDir) with RuntimeIdentifier $(RuntimeIdentifier)" />

    <PropertyGroup Condition="'$(_AppBundlePath)' == ''">
      <CefResistOSXArm64SourceDir>$(MSBuildThisFileDirectory)../CEF/osx-arm64</CefResistOSXArm64SourceDir>
      <CefRedistOSXArm64TargetDir Condition="'$(CefRedistOSXArm64TargetDir)' == ''">$(TargetDir)</CefRedistOSXArm64TargetDir>
      <CefRedistOSXArm64ResourceTargetDir Condition="'$(CefRedistOSXArm64ResourceTargetDir)' == ''">$(TargetDir)\Resources</CefRedistOSXArm64ResourceTargetDir>
    </PropertyGroup>

    <ItemGroup>
      <_CefRuntimeOSXArm64Main Include="$(CefResistOSXArm64SourceDir)/Chromium Embedded Framework" />
      <_CefRuntimeOSXArm64Libraries Include="$(CefResistOSXArm64SourceDir)/Libraries/**/*.*" />
      <_CefRuntimeOSXArm64Resources Include="$(CefResistOSXArm64SourceDir)/Resources/**/*.*" />
    </ItemGroup>
    
    <Message Importance="high" Text="Copying Chromium Embedded Framework Runtime arm64 files from $(CefResistOSXArm64SourceDir) to $(CefRedistOSXArm64TargetDir)" />
    <Copy SourceFiles="@(_CefRuntimeOSXArm64Main)" DestinationFiles="@(_CefRuntimeOSXArm64Main->'$(CefRedistOSXArm64TargetDir)\libcef.dylib')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_CefRuntimeOSXArm64Libraries)" DestinationFiles="@(_CefRuntimeOSXArm64Libraries->'$(CefRedistOSXArm64TargetDir)\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_CefRuntimeOSXArm64Resources)" DestinationFiles="@(_CefRuntimeOSXArm64Resources->'$(CefRedistOSXArm64ResourceTargetDir)\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <PropertyGroup>
    <!-- Override with your Team ID or full certificate name -->
    <CefBundleCodesignKey Condition="'$(CefBundleCodesignKey)' == ''">-</CefBundleCodesignKey>
  </PropertyGroup>

  <Target Name="ResignBundleAfterCefCopy"
          Condition="'$(_AppBundlePath)' != '' AND $([MSBuild]::IsOSPlatform('OSX'))">
    <Message Importance="high" Text="Re-signing bundle with identity: $(CefBundleCodesignKey)" />
    <!-- Sign all CEF dylibs individually first; -deep does not re-sign flat dylibs in MonoBundle -->
    <Exec Condition="'$(CefBundleCodesignKey)' != '-'"
          Command="find &quot;$(_AppBundlePath)Contents/MonoBundle&quot; -name '*.dylib' -exec codesign --force --sign &quot;$(CefBundleCodesignKey)&quot; {} \;" />
    <!-- Adhoc signing (-) does not support -options runtime; Developer ID requires it for SecCodeCopySelf on macOS 15 -->
    <Exec Condition="'$(CefBundleCodesignKey)' == '-' OR '$(CefBundleEntitlementsFile)' == ''"
          Command="codesign --force --sign &quot;$(CefBundleCodesignKey)&quot; &quot;$(_AppBundlePath)&quot;" />
    <Exec Condition="'$(CefBundleCodesignKey)' != '-' AND '$(CefBundleEntitlementsFile)' != ''"
          Command="codesign --force --sign &quot;$(CefBundleCodesignKey)&quot; --options runtime --entitlements &quot;$(CefBundleEntitlementsFile)&quot; &quot;$(_AppBundlePath)&quot;" />
  </Target>
</Project>