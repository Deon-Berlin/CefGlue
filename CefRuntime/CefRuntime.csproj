<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="../CefVersion.props" />

  <!-- override the value for cef version from pipeline parameter -->
  <PropertyGroup Condition="$(CefBuildVersion) != ''">
    <CefVersion>$(CefBuildVersion.Split('+')[0])</CefVersion>
  </PropertyGroup>
  
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifiers>osx-arm64;osx-x64;linux-arm64;linux-x64</RuntimeIdentifiers>
    <CurrentPlatform>osx</CurrentPlatform>
    <CurrentPlatform Condition="$([MSBuild]::IsOSPlatform('Linux'))">linux</CurrentPlatform>
    <SecondaryRuntime Condition="$(RuntimeIdentifier) == ''">$(CurrentPlatform)-x64</SecondaryRuntime>
    <RuntimeIdentifier Condition="$(RuntimeIdentifier) == ''">$(CurrentPlatform)-arm64</RuntimeIdentifier>
    <PackageOutputPath>../LocalPackages</PackageOutputPath>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
  </PropertyGroup>
  
  <PropertyGroup>
    <PackageId>cef.runtime.$(RuntimeIdentifier)</PackageId>
    <VersionPrefix Condition="'$(CefRuntimePackageVersion)' != ''">$(CefRuntimePackageVersion)</VersionPrefix>
    <VersionPrefix Condition="'$(VersionPrefix)' == ''">$(CefVersion)</VersionPrefix>
    <Authors>The Chromium Embedded Framework Authors</Authors>
    <Copyright>Copyright © 2025</Copyright>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageIcon>images\cef128x128.png</PackageIcon>
    <PackageTags>chrome chromium native embedded browser CEF nativepackage $(RuntimeIdentifier)</PackageTags>
    <RepositoryUrl>https://github.com/Deon-Berlin/CefGlue</RepositoryUrl>
    <Description>
      Chromium Embedded Framework (CEF) Release Distribution
      NOTE: This package is maintained on behalf of the CEF authors by DEON
    </Description>
  </PropertyGroup>
  
  <ItemGroup>
    <None Include="LICENSE.txt" Pack="true" PackagePath=""/>
    <None Include="cef128x128.png" Pack="true" PackagePath="images"/>
    <None Include="deploy-cef-framework.sh" Pack="true" PackagePath="CEF/" Condition="$(RuntimeIdentifier.StartsWith('osx-'))" />
    <None Include="cef.entitlements" Pack="true" PackagePath="CEF/" Condition="$(RuntimeIdentifier.StartsWith('osx-'))" />
    <None Include="app.icns" Pack="true" PackagePath="CEF/" Condition="$(RuntimeIdentifier.StartsWith('osx-'))" />
    <None Include="cef.runtime.$(RuntimeIdentifier).props" Pack="true" PackagePath="build" />
    <None Include="cef.runtime.$(RuntimeIdentifier).props" Pack="true" PackagePath="buildTransitive" />
  </ItemGroup>

  <!-- The staged redist CEF binaries are added to the package via
       TargetsForTfmSpecificContentInPackage (see AddCefRedistToPackage) rather than a
       plain None glob. A None glob is evaluated at project-load time, when the redist
       files usually do not exist yet (they are produced by PrepareRedist), so it only
       worked as a two-step "stage, then pack" flow and, on re-runs, produced a
       duplicate item that made NuGet pack silently drop the space-containing macOS
       bundle paths on Windows. Collecting the files in a pack-time target fixes both. -->
  <PropertyGroup>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);AddCefRedistToPackage</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <!-- Run before GenerateNuspec so the produced files are available when the nuspec is assembled -->
  <Target Name="PrepareRedist" BeforeTargets="GenerateNuspec;Build">
    <PropertyGroup>
      <IsWindows Condition="$([MSBuild]::IsOSPlatform('Windows'))">true</IsWindows>
      <RedistBuildScript>$(MSBuildThisFileDirectory)make_cefredist_linux.sh</RedistBuildScript>
      <RedistBuildScript Condition="$(RuntimeIdentifier.StartsWith('osx-'))">$(MSBuildThisFileDirectory)make_cefredist_osx.sh</RedistBuildScript>
    </PropertyGroup>

    <Exec Command="chmod 755 $(RedistBuildScript)" Condition="'$(IsWindows)' != 'true'" />
    <Exec Command="$(RedistBuildScript) $(RuntimeIdentifier) $(CefBuildVersion)" Condition="'$(IsWindows)' != 'true'" />

    <PropertyGroup Condition="'$(IsWindows)' == 'true'">
      <PowerShellExe Condition=" '$(PowerShellExe)'=='' ">%WINDIR%\System32\WindowsPowerShell\v1.0\powershell.exe</PowerShellExe>
      <ScriptShell>$(MSBuildThisFileDirectory)make_cefredist.ps1</ScriptShell>
    </PropertyGroup>

    <Exec Command="$(PowerShellExe) -File &quot;$(ScriptShell)&quot; &quot;$(RedistBuildScript)&quot; &quot;$(RuntimeIdentifier)&quot; &quot;$(CefBuildVersion)&quot;"
          Condition="'$(IsWindows)' == 'true'" />

  </Target>

  <!-- Collect the staged redist files into the package. Invoked during pack via
       TargetsForTfmSpecificContentInPackage and depends on PrepareRedist so the glob is
       expanded after the files have been produced, making a single `dotnet pack`
       invocation self-contained on every platform. -->
  <Target Name="AddCefRedistToPackage" DependsOnTargets="PrepareRedist">
    <ItemGroup>
      <_CefRedistFile Include="redist/package-$(RuntimeIdentifier)-$(CefVersion)/CEF/**/*" />
      <!-- PackagePath is only the destination root; NuGet appends each file's own
           %(RecursiveDir)%(Filename)%(Extension). Do NOT add %(RecursiveDir) here or it
           is applied twice (which doubled every path, e.g. the extensionless macOS
           framework binary). -->
      <TfmSpecificPackageFile Include="@(_CefRedistFile)">
        <PackagePath>CEF/$(RuntimeIdentifier)/</PackagePath>
      </TfmSpecificPackageFile>
    </ItemGroup>
  </Target>

  <Target Name="BuildSecondaryRuntime" Condition="'$(SecondaryRuntime)' != ''"
          AfterTargets="Build">
    <MSBuild Projects="$(MSBuildThisFileFullPath)" Properties="RuntimeIdentifier=$(SecondaryRuntime)" />
  </Target>

</Project>
