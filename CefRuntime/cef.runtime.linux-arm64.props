<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup>
    <CefRuntimeLinuxArm64 Include="$(MSBuildThisFileDirectory)..\runtimes\linux-arm64\native\*.*" />
    <_CefRuntimeLinuxArm64Additional Include="$(MSBuildThisFileDirectory)..\CEF\linux-arm64\**\*.*" />

    <CefRedistLinuxArm64 Include="@(CefRuntimeLinuxArm64)" />
    <CefRedistLinuxArm64 Include="@(_CefRuntimeLinuxArm64Additional)" />
  </ItemGroup>

  <Target Name="CefRedistLinuxArm64CopyResources" AfterTargets="Build" Condition="'$(RuntimeIdentifier)' == 'linux-arm64' AND '$(OutputType)' == 'Exe'">
    <PropertyGroup>
      <CefRedistLinuxArm64TargetDir Condition="'$(CefRedistLinuxArm64TargetDir)' == ''">$(TargetDir)</CefRedistLinuxArm64TargetDir>
    </PropertyGroup>
    
    <ItemGroup>
      <_CefRuntimeLinuxArm64 Include="$(MSBuildThisFileDirectory)..\runtimes\linux-arm64\native\*.*" />
      <_CefRuntimeLinuxArm64 Include="$(MSBuildThisFileDirectory)..\CEF\linux-arm64\**\*.*" />
    </ItemGroup>
    <Message Importance="high" Text="Copying Chromium Embedded Framework Runtime arm64 files from $(MSBuildThisFileDirectory)..\runtimes\linux-arm64\native to $(CefRedistLinuxArm64TargetDir)" />
    <Copy SourceFiles="@(_CefRuntimeLinuxArm64)" DestinationFiles="@(_CefRuntimeLinuxArm64->'$(CefRedistLinuxArm64TargetDir)\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
